{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hmcts/.github//renovate/automerge-all",
    "local>hmcts/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "The java Helm chart is not a Java runtime - lift the built-in Java LTS version filter (workarounds:javaLTSVersions matches deps named java)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "hmctsprod.azurecr.io/helm/java"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "versioning": "semver"
    }
  ]
}
